[usrp]
remote_host = 198.51.100.10   # AllStarLink server IP
remote_port = 34001
local_port  = 32001
bind_address = 0.0.0.0

[audio]
alsa_device     = plughw:1,0
input_gain_db   = 0.0           # -12.0 to +12.0 dB
output_gain_db  = 0.0
input_highpass  = false         # 250 Hz HPF — blocks CTCSS/DCS
output_highpass = false
input_bandpass  = false         # 300-2700 Hz 3rd-order Chebyshev bandpass — matches MMDVM-Host's RX audio bandwidth exactly
output_bandpass = false         # don't enable both *_highpass and *_bandpass on the same path -- the bandpass already has its own ~300 Hz low-cut

input_leading_trim_ms  = 0      # 0–260 ms, rounded to nearest 20 ms frame
output_leading_trim_ms = 0

# codec: pcm (default, standard ASL3 compatibility) or opus
# Opus mode requires usrp-reflector or a compatible server on the far end.
# Set jitter_buffer_ms to at least two packets: 60 for 20 ms frames, 120 for 60 ms.
codec         = pcm
opus_bitrate  = 8000            # VBR target in bps (4000–64000); 8000 is transparent for narrowband FM
opus_frame_ms = 60              # 20, 40 or 60 only; 20 = least delay, 60 = fewest packets (README: Choosing a frame size)

[logic]
hid_device         = /dev/hidraw0
output_active_gpio = 3          # CM119A GPIO3 (pin 13) — PTT
input_active_low   = true       # input signal is active when pulled low
output_active_low  = true       # output signal is active-low (open-collector driver)
half_duplex        = false      # true: block second direction until first releases (first-come-first-served)

[network]
jitter_buffer_ms = 60           # 40–250 ms (rounds up to nearest 20 ms frame)

[watchdog]
network_timeout_ms        = 500   # no USRP traffic → force unkey
output_active_tail_ms     = 100   # hold output_active after UNKEY
startup_output_inhibit_ms = 2000  # suppress output at boot
unkey_debounce_ms         = 0     # wait N ms before acting on unkey; absorbs brief keyup=0 gaps

[logging]
level               = info    # debug, info, warn, error
status_interval_sec = 10
